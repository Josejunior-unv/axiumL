# Copie para .env e preencha.

# Token do bot (pegue com o @BotFather no Telegram) — obrigatório
TELEGRAM_TOKEN=

# Chave da API da Anthropic — opcional.
# Sem ela o bot ainda agenda e guarda notas, mas não conversa.
ANTHROPIC_API_KEY=

# Só estes chats podem usar o bot (o seu id sai no /start do @userinfobot).
# Vazio = qualquer pessoa que achar o bot. Recomendado preencher.
TELEGRAM_CHATS_PERMITIDOS=

# --- Opcionais (os padrões já servem) ---
# BOT_FUSO=America/Sao_Paulo
# BOT_DB=dados/assistente.db
# BOT_ANTECEDENCIA_MIN=30          # quanto antes avisar de um compromisso
# BOT_RESUMO_DIARIO=08:00          # resumo da manhã (vazio para desligar)
# BOT_INTERVALO_SEGUNDOS=30        # de quanto em quanto tempo a fila é verificada
# BOT_MODELO=claude-opus-5
# BOT_ESFORCO=low                  # low | medium | high — mais alto = mais caro e lento
# BOT_MAX_TOKENS=16000
# BOT_HISTORICO=20                 # mensagens de contexto mantidas por chat
# BOT_FALLBACK=1                   # 1 = usa fallback do servidor se o modelo recusar
