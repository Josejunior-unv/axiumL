# Copie para .env e preencha.

# Token do bot (pegue com o @BotFather no Telegram) — obrigatório
TELEGRAM_TOKEN=

# Chave da API da Anthropic — opcional.
# Sem ela o bot ainda agenda e guarda notas, mas não conversa.
ANTHROPIC_API_KEY=

# Este bot é de uma pessoa só. Deixando VAZIO, o primeiro chat que falar com ele
# vira o dono e mais ninguém entra — não precisa descobrir id nenhum.
# Só preencha se quiser fixar na mão (ou liberar para duas pessoas): ids
# separados por vírgula, o seu sai no @userinfobot.
TELEGRAM_CHATS_PERMITIDOS=

# Banco. Por padrão é um arquivo SQLite em dados/assistente.db, que serve para
# computador, VPS e Raspberry Pi. Em hospedagem cujo disco é apagado a cada
# deploy (Render e afins), aponte para um Postgres externo — aí a agenda fica:
# DATABASE_URL=postgresql://usuario:senha@host/banco

# --- Opcionais (os padrões já servem) ---
# BOT_FUSO=America/Sao_Paulo
# BOT_DB=dados/assistente.db       # ignorado quando DATABASE_URL está preenchida
# PORT=10000                       # a hospedagem costuma definir sozinha; abre a /saude
# BOT_ANTECEDENCIA_MIN=30          # quanto antes avisar de um compromisso
# BOT_RESUMO_DIARIO=08:00          # resumo da manhã (vazio para desligar)
# BOT_INTERVALO_SEGUNDOS=30        # de quanto em quanto tempo a fila é verificada
# BOT_MODELO=claude-opus-5
# BOT_ESFORCO=low                  # low | medium | high — mais alto = mais caro e lento
# BOT_MAX_TOKENS=16000
# BOT_HISTORICO=20                 # mensagens de contexto mantidas por chat
# BOT_FALLBACK=1                   # 1 = usa fallback do servidor se o modelo recusar
# BOT_ABERTO=0                     # 1 libera o bot para qualquer pessoa (não recomendado)
